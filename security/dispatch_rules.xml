<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- =========================================================
             DISPATCH ORDERS – COMPANY ISOLATION
             ========================================================= -->

        <record id="rule_dispatch_order_company_manager" model="ir.rule">
            <field name="name">Dispatch Orders: Company Isolation (Manager)</field>
            <field name="model_id" ref="model_meera_dispatch_order"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', '=', user.company_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('odoo_pos_dispatch.group_meera_dispatch_manager'))]"/>
        </record>

        <record id="rule_dispatch_order_company_user" model="ir.rule">
            <field name="name">Dispatch Orders: Company Isolation (User)</field>
            <field name="model_id" ref="model_meera_dispatch_order"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', '=', user.company_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('odoo_pos_dispatch.group_meera_dispatch_user'))]"/>
        </record>

        <!-- =========================================================
             DRIVER LOCATIONS – COMPANY ISOLATION
             ========================================================= -->

        <record id="rule_driver_location_company_manager" model="ir.rule">
            <field name="name">Driver Locations: Company Isolation (Manager)</field>
            <field name="model_id" ref="model_meera_driver_location"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', '=', user.company_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('odoo_pos_dispatch.group_meera_dispatch_manager'))]"/>
        </record>

        <record id="rule_driver_location_company_user" model="ir.rule">
            <field name="name">Driver Locations: Company Isolation (User)</field>
            <field name="model_id" ref="model_meera_driver_location"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', '=', user.company_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('odoo_pos_dispatch.group_meera_dispatch_user'))]"/>
        </record>

    </data>
</odoo>
