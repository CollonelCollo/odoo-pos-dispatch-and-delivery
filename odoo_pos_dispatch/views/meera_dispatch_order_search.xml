<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meera_dispatch_order_search" model="ir.ui.view">
        <field name="name">meera.dispatch.order.search</field>
        <field name="model">meera.dispatch.order</field>
        <field name="arch" type="xml">
            <search string="Dispatch Orders">
                <!-- Quick search -->
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pos_order_id"/>

                <!-- Common filters (adjust field names to match your model) -->
                <filter string="Active" name="active_only" domain="[('state', 'not in', ('delivered','cancelled'))]"/>
                <filter string="History" name="history_only" domain="[('state', 'in', ('delivered','cancelled'))]" context="{'history_only': 1}"/>

                <separator/>

                <!-- These two are referenced by your action context defaults -->
                <filter string="Last 7 Days" name="last_7_days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d 00:00:00'))]"/>

                <!-- Example group-by -->
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Driver" name="group_driver" context="{'group_by':'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
