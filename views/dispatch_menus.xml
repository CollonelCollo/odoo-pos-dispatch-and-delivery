<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =========================================================
             ACTIONS
             ========================================================= -->

        <record id="action_meera_dispatch_dashboard" model="ir.actions.act_window">
            <field name="name">Dispatch Dashboard</field>
            <field name="res_model">meera.dispatch.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_meera_dispatch_order_kanban"/>
            <field name="search_view_id" ref="view_meera_dispatch_order_search"/>
            <field name="context">{'group_by': 'state'}</field>
        </record>

        <record id="action_meera_dispatch_history" model="ir.actions.act_window">
            <field name="name">Dispatch History</field>
            <field name="res_model">meera.dispatch.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_meera_dispatch_order_kanban"/>
            <field name="search_view_id" ref="view_meera_dispatch_order_search"/>
            <field name="context">
                {
                    'search_default_history_only': 1,
                    'search_default_last_7_days': 1,
                    'group_by': 'state'
                }
            </field>
        </record>

        <record id="action_meera_dispatch_my_company" model="ir.actions.act_window">
            <field name="name">My Company Dispatch</field>
            <field name="res_model">meera.dispatch.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_meera_dispatch_order_kanban"/>
            <field name="search_view_id" ref="view_meera_dispatch_order_search"/>
            <field name="context">
                {
                    'search_default_active_only': 1,
                    'search_default_my_company': 1,
                    'search_default_group_dispatch_state': 1,
                    'group_by': 'state'
                }
            </field>
        </record>

        <record id="action_meera_dispatch_my_jobs" model="ir.actions.act_window">
            <field name="name">My Dispatch Jobs</field>
            <field name="res_model">meera.dispatch.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_meera_dispatch_order_kanban"/>
            <field name="search_view_id" ref="view_meera_dispatch_order_search"/>
            <field name="context">
                {
                    'search_default_active_only': 1,
                    'search_default_my_jobs': 1,
                    'group_by': 'state'
                }
            </field>
        </record>

        <record id="action_dispatch_drivers" model="ir.actions.act_window">
            <field name="name">Drivers</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('dispatch_driver_id','!=',False)]</field>
        </record>

        <record id="action_meera_dispatch_orders" model="ir.actions.act_window">
            <field name="name">All Dispatch Orders</field>
            <field name="res_model">meera.dispatch.order</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_meera_dispatch_order_search"/>
        </record>

        <record id="action_meera_driver_locations" model="ir.actions.act_window">
            <field name="name">Driver Locations</field>
            <field name="res_model">meera.driver.location</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_meera_driver_location_search"/>
        </record>

        <!-- =========================================================
             ROOT APP MENU (ADMIN ONLY)
             - Keep the root menu WITHOUT an action to avoid hiding the app tile
               when the action/model is not accessible for non-admin users.
             ========================================================= -->

        <menuitem id="menu_meera_dispatch_root"
                  name="Dispatch"
                  sequence="2"
                  groups="base.group_system"
                  web_icon="odoo_pos_dispatch,static/description/icon.png"/>

        <!-- =========================================================
             SUBMENUS (ADMIN ONLY) - KEEP GROUPS ON ONE LINE
             ========================================================= -->

        <menuitem id="menu_meera_dispatch_dashboard"
                  name="Dispatch Dashboard"
                  parent="menu_meera_dispatch_root"
                  action="action_meera_dispatch_dashboard"
                  sequence="5"
                  groups="base.group_system"/>

        <menuitem id="menu_meera_dispatch_history"
                  name="Dispatch History"
                  parent="menu_meera_dispatch_root"
                  action="action_meera_dispatch_history"
                  sequence="6"
                  groups="base.group_system"/>

        <menuitem id="menu_meera_dispatch_my_company"
                  name="My Company Dispatch"
                  parent="menu_meera_dispatch_root"
                  action="action_meera_dispatch_my_company"
                  sequence="7"
                  groups="base.group_system"/>

        <menuitem id="menu_meera_dispatch_my_jobs"
                  name="My Dispatch Jobs"
                  parent="menu_meera_dispatch_root"
                  action="action_meera_dispatch_my_jobs"
                  sequence="8"
                  groups="base.group_system"/>

        <menuitem id="menu_dispatch_drivers"
                  name="Drivers"
                  parent="menu_meera_dispatch_root"
                  action="action_dispatch_drivers"
                  sequence="9"
                  groups="base.group_system"/>

        <menuitem id="menu_meera_dispatch_orders"
                  name="All Dispatch Orders"
                  parent="menu_meera_dispatch_root"
                  action="action_meera_dispatch_orders"
                  sequence="20"
                  groups="base.group_system"/>

        <menuitem id="menu_meera_driver_locations"
                  name="Driver Locations"
                  parent="menu_meera_dispatch_root"
                  action="action_meera_driver_locations"
                  sequence="50"
                  groups="base.group_system"/>

    </data>
</odoo>
