<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_meera_dispatch_sync_from_pos" model="ir.cron">
        <field name="name">Meera Dispatch: Sync customer fields from POS</field>
        <field name="model_id" ref="model_meera_dispatch_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_dispatch_from_pos(limit=500)</field>

        <field name="interval_number">3</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
    </record>

    <!-- =========================================================
         DRIVER LOCATION RETENTION (APPEND-ONLY TRAIL PRUNING)
         Keeps the table from growing forever.
         ========================================================= -->
    <record id="ir_cron_meera_driver_location_prune" model="ir.cron">
        <field name="name">Meera Dispatch: Prune old driver locations</field>
        <field name="model_id" ref="model_meera_driver_location"/>
        <field name="state">code</field>
        <field name="code">model.cron_prune_locations(days=30, limit=50000)</field>

        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
